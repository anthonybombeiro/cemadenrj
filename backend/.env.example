# Copie para .env e ajuste os valores.

DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1

# Deixe em branco para usar SQLite localmente (padrão de desenvolvimento).
# Em produção/Docker: postgres://usuario:senha@postgres:5432/cemaden_rj
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000

REDIS_URL=redis://localhost:6379/0

# Token gratuito solicitado ao INMET (portal.inmet.gov.br) para o endpoint
# histórico /token/estacao/{inicio}/{fim}/{estacao}/{token}. Sem ele, a lista
# de estações e metadados ainda funcionam, mas não as séries horárias do INMET.
INMET_API_TOKEN=

# Desliga o scraping local via Selenium/Chrome (usado só em dev, já que o
# HostGator não roda Chrome). Em produção no HostGator, deixe False — as
# leituras do INMET chegam via /api/ingest/readings/ (GitHub Actions).
INMET_SCRAPE_ENABLED=True

# Segredo compartilhado com o worker do GitHub Actions que faz o scraping do
# INMET com um Chrome de verdade e envia os resultados para
# /api/ingest/readings/. Gere com `openssl rand -hex 32` (ou equivalente) e
# configure o MESMO valor como secret INGEST_SHARED_SECRET no repositório
# GitHub (Settings > Secrets and variables > Actions).
INGEST_SHARED_SECRET=

# Endereço documentado do webservice nacional do CEMADEN (ver
# docs/fontes-de-dados.md). Pode estar indisponível fora da rede do governo —
# confirmar a partir do servidor de produção.
CEMADEN_NACIONAL_BASE_URL=http://150.163.255.240/CEMADEN/resources/parceiros
